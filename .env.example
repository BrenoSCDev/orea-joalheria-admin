# joalheria-admin — Vite variables are inlined at BUILD time.
# Local dev: copy to .env  |  Docker image: passed as --build-arg (see deploy/build-frontends.sh)

# joalheria-api base URL (nginx of the stack + /api)
VITE_API_BASE_URL=http://localhost:83/api

# Reverb (real-time). ⚠ PREENCHER: must equal REVERB_APP_KEY in joalheria-api/.env
# Leave empty to disable real-time (the panel keeps working with manual refresh).
VITE_REVERB_APP_KEY=
# Host/port the BROWSER uses to reach Reverb (published port of the "reverb" service)
VITE_REVERB_HOST=localhost
VITE_REVERB_PORT=8093
VITE_REVERB_SCHEME=http

# Public site URL, used by "Ver no site" links in the panel
VITE_SITE_URL=http://localhost:5181
